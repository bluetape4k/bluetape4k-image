digraph G {
  graph [rankdir=TB, bgcolor="transparent", nodesep=0.55, ranksep=0.75, splines=ortho]
  node [shape=record, style="rounded,filled", fontname="Comic Mono", fontsize=10, margin="0.10,0.08"]
  edge [color="#758297", arrowsize=0.7]

  extensions [label="{ImmutableImage OCR Extensions|+ extractText(...)\l+ suspendExtractText(...)\l}", fillcolor="#EAF7EF", color="#58A978"]
  engineApi [label="{OcrEngine|+ recognize(image, options): OcrResult\l}", fillcolor="#E8F3FF", color="#5B8DEF"]
  engine [label="{TesseractOcrEngine|+ TesseractOcrEngine()\l+ recognize(...)\l- configure(...)\l}", fillcolor="#F1ECFF", color="#A58BE3"]
  client [label="{TesseractClient|+ setLanguage(...)\l+ doOCR(image): String\l}", fillcolor="#EAF7EF", color="#58A978"]
  clientImpl [label="{Tess4jTesseractClient|wraps ITesseract\l}", fillcolor="#FFF0E6", color="#E28A5D"]
  options [label="{OcrOptions|languages\ltessdataPath\lengineMode/pageSegmentationMode\lvariables/configs/trimText\l}", fillcolor="#FFF3D9", color="#D6A441"]
  result [label="{OcrResult|text: String\loptions: OcrOptions\l}", fillcolor="#E8F3FF", color="#5B8DEF"]
  engineMode [label="{TesseractEngineMode|DEFAULT, LSTM_ONLY, ...\l}", fillcolor="#F7F1E7", color="#B88A44"]
  pageMode [label="{TesseractPageSegmentationMode|AUTO, SINGLE_LINE, SPARSE_TEXT, ...\l}", fillcolor="#F1ECFF", color="#A58BE3"]
  ocrException [label="{OcrException|message\lcause\l}", fillcolor="#FDECEF", color="#DC6B82"]
  configException [label="{OcrConfigurationException|native runtime / tessdata setup\l}", fillcolor="#FFF0E6", color="#E28A5D"]

  engine -> engineApi [arrowhead=empty, style=dashed]
  clientImpl -> client [arrowhead=empty, style=dashed]
  configException -> ocrException [arrowhead=empty]
  extensions -> engine
  engine -> result
  engine -> options
  options -> engineMode
  options -> pageMode
  engine -> client
}
