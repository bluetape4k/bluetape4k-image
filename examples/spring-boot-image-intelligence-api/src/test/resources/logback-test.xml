<configuration>
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} %-5level [%thread] %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <logger
        name="io.bluetape4k.images.examples.spring.intelligence.service.ImageIntelligenceService"
        level="INFO"
    />

    <root level="WARN">
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>
