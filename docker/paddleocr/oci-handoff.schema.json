{
  "$id": "https://bluetape4k.github.io/schema/paddleocr/oci-handoff.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "attemptId": {
      "pattern": "^[1-9][0-9]*\\.[1-9][0-9]*$",
      "type": "string"
    },
    "baseDigest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "createdAt": {
      "format": "date-time",
      "pattern": "Z$",
      "type": "string"
    },
    "imageConfigDigest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "imageIndexDigest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "imagePlatformDigest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "imageTarSha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "inputLockSha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "modelPairSha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "modelTreeDigests": {
      "additionalProperties": false,
      "properties": {
        "detector": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "recognizer": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        }
      },
      "required": [
        "detector",
        "recognizer"
      ],
      "type": "object"
    },
    "runAttempt": {
      "minimum": 1,
      "type": "integer"
    },
    "runId": {
      "minimum": 1,
      "type": "integer"
    },
    "schemaVersion": {
      "const": 1
    },
    "sourceDateEpoch": {
      "minimum": 1,
      "type": "integer"
    },
    "stagingArtifactSha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "targetPlatform": {
      "const": "linux/amd64"
    }
  },
  "required": [
    "schemaVersion",
    "attemptId",
    "runId",
    "runAttempt",
    "inputLockSha256",
    "stagingArtifactSha256",
    "imageTarSha256",
    "imageIndexDigest",
    "imagePlatformDigest",
    "imageConfigDigest",
    "baseDigest",
    "targetPlatform",
    "sourceDateEpoch",
    "modelTreeDigests",
    "modelPairSha256",
    "createdAt"
  ],
  "title": "PaddleOCR producer OCI handoff",
  "type": "object"
}
