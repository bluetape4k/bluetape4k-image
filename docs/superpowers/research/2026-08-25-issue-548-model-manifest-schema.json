{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "issue-548-model-manifest-schema-v1",
  "title": "Issue 548 classifier model manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifestVersion",
    "schemaRef",
    "schemaDigest",
    "modelId",
    "modelVersion",
    "source",
    "artifact",
    "onnx",
    "preprocess",
    "labels",
    "output",
    "license"
  ],
  "properties": {
    "manifestVersion": { "const": 1 },
    "schemaRef": { "type": "string", "minLength": 1 },
    "schemaDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "modelId": { "type": "string", "minLength": 1 },
    "modelVersion": { "type": "string", "minLength": 1 },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "ref", "path", "retrievedAt"],
      "properties": {
        "repository": { "type": "string", "format": "uri" },
        "ref": { "type": "string", "minLength": 40 },
        "path": { "type": "string", "minLength": 1 },
        "documentationRef": { "type": "string", "format": "uri" },
        "retrievedAt": { "type": "string", "format": "date" }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "bytes", "sha256", "externalData", "customOperators"],
      "properties": {
        "format": { "const": "onnx" },
        "bytes": { "type": "integer", "minimum": 1 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "externalData": { "const": false },
        "customOperators": { "const": false }
      }
    },
    "onnx": {
      "type": "object",
      "additionalProperties": false,
      "required": ["onnxVersion", "irVersion", "opset", "inputs", "outputs", "head"],
      "properties": {
        "onnxVersion": { "type": "string", "minLength": 1 },
        "irVersion": { "type": "integer", "minimum": 1 },
        "opset": { "type": "integer", "minimum": 1 },
        "inputs": { "type": "array", "minItems": 1 },
        "outputs": { "type": "array", "minItems": 1 },
        "head": { "type": "array", "minItems": 1 }
      }
    },
    "preprocess": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "color": { "type": "string" },
        "resizeShortSide": { "type": "integer", "minimum": 1 },
        "crop": { "type": "object", "additionalProperties": true },
        "layout": { "type": "string" },
        "scale": { "type": "number" },
        "mean": { "type": "array", "minItems": 3, "maxItems": 3 },
        "std": { "type": "array", "minItems": 3, "maxItems": 3 },
        "interpolation": { "type": "string" }
      }
    },
    "labels": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "ref", "bytes", "count", "sha256"],
      "properties": {
        "source": { "type": "string", "format": "uri" },
        "ref": { "type": "string", "minLength": 40 },
        "bytes": { "type": "integer", "minimum": 1 },
        "count": { "type": "integer", "minimum": 1 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": { "type": "string" },
        "topK": { "type": "integer", "minimum": 1 },
        "tieBreak": { "type": "string" }
      }
    },
    "license": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": { "type": "string" },
        "modelWeights": { "type": "string" },
        "dataset": { "type": "string" },
        "notice": { "type": "string" }
      }
    }
  }
}
