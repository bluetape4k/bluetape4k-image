digraph G {
  graph [rankdir=LR, bgcolor="#F6F9FC", margin=0.18, nodesep=0.55, ranksep=0.75];
  node [shape=box, style="rounded,filled", fillcolor="#FFFFFF", color="#9AA8B8", fontname="Comic Mono", fontsize=11];
  edge [color="#758297", fontname="Comic Mono", fontsize=9];
  label="Basic Processing Sequence";
  labelloc="t";
  "user" [label="User"];
  "main" [label="main"];
  "generator" [label="Generator"];
  "resources" [label="Resources"];
  "outputs" [label="Outputs"];
  "user" -> "main" [label="Run :basic-processing:run"];
  "main" -> "generator" [label="Create output directory"];
  "generator" -> "resources" [label="Load cafe, landscape, workbench"];
  "generator" -> "outputs" [label="Write thumbnail, crop, PNG, watermark, preview"];
  "outputs" -> "generator" [label="Return GeneratedImage metadata"];
  "generator" -> "user" [label="Print file names and dimensions"];
}
