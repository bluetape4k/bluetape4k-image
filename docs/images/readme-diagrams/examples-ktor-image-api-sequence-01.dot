digraph G {
  graph [rankdir=LR, bgcolor="#F6F9FC", margin=0.18, nodesep=0.55, ranksep=0.75];
  node [shape=box, style="rounded,filled", fillcolor="#FFFFFF", color="#9AA8B8", fontname="Comic Mono", fontsize=11];
  edge [color="#758297", fontname="Comic Mono", fontsize=9];
  label="Ktor Image API Sequence";
  labelloc="t";
  "client" [label="Client"];
  "ktor" [label="Ktor app"];
  "captcha" [label="CAPTCHA helper"];
  "thumb" [label="Thumbnail helper"];
  "response" [label="Response"];
  "client" -> "ktor" [label="GET /api/captcha?length=4"];
  "ktor" -> "captcha" [label="Create challenge image"];
  "captcha" -> "response" [label="Return issue JSON with base64 PNG"];
  "client" -> "ktor" [label="POST /api/captcha/{id}/verify"];
  "client" -> "ktor" [label="POST multipart thumbnail"];
  "ktor" -> "thumb" [label="Fit image to maxSide"];
  "thumb" -> "response" [label="Return PNG thumbnail bytes"];
}
