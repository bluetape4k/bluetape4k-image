digraph G {
  graph [rankdir=LR, bgcolor="#F6F9FC", margin=0.18, nodesep=0.55, ranksep=0.75];
  node [shape=box, style="rounded,filled", fillcolor="#FFFFFF", color="#9AA8B8", fontname="Comic Mono", fontsize=11];
  edge [color="#758297", fontname="Comic Mono", fontsize=9];
  label="Ktor OCR API Sequence";
  labelloc="t";
  "client" [label="Client"];
  "route" [label="Ktor route"];
  "service" [label="Service"];
  "ocr" [label="images-ocr"];
  "native" [label="Tesseract"];
  "client" -> "route" [label="POST multipart image and languages"];
  "route" -> "service" [label="Validate content type and file"];
  "service" -> "ocr" [label="Build OcrOptions and extract text"];
  "ocr" -> "native" [label="Run Tess4J OCR"];
  "ocr" -> "service" [label="Return recognized text"];
  "service" -> "client" [label="Return JSON text result"];
}
